# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript API Key for the Contact map.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# LOCAL_ADMIN_PASSCODE: Optional server-side administrator passcode for Workshop Passcode login (overrides claimed setup passcode).
LOCAL_ADMIN_PASSCODE=
